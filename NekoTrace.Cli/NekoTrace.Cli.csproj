<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <RootNamespace>NekoTrace.Cli</RootNamespace>
        <!-- Output is UTC and invariant by design; this also drops ICU from the self-contained builds. -->
        <InvariantGlobalization>true</InvariantGlobalization>
        <!--
          System.CommandLine ships thirteen translations, each as its own folder in the publish output.
          InvariantGlobalization means none of them can ever be selected.
        -->
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <!--
          NekoTrace.Web publishes this project into its own output, so restore needs assets for every runtime
          its publish profiles name. Add one here when a profile there gains one, or that publish fails with
          NETSDK1047.
        -->
        <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" />
    </ItemGroup>

</Project>
