<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>389d3aa4-6bfc-45e4-90b8-6cf0cd0ea7a2</UserSecretsId>
        <PublishIISAssets>false</PublishIISAssets>
        <!-- Set here as well as in tsconfig.json, because the MSBuild default overrides it. -->
        <TypeScriptTarget>ESNext</TypeScriptTarget>
    </PropertyGroup>

    <ItemGroup>
		<Protobuf Include="Protos\**" GrpcServices="Server" ProtoRoot="Protos\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="NekoTrace.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Blazor-ApexCharts" />
        <PackageReference Include="Grpc.AspNetCore" />
        <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" />
        <PackageReference Include="Microsoft.TypeScript.MSBuild">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!--
      Not referenced in code: this is what makes restore aware the CLI project exists. The
      PublishNekoTraceCli target below reaches it through an MSBuild task, which runs long after restore
      has settled what it is restoring, so without this the CLI has no assets file and a publish from a
      clean checkout fails with NETSDK1004.

      SkipGetTargetFrameworkProperties keeps this a restore-time edge and nothing more. Without it the
      self-contained profiles fail with NETSDK1150, over a reference that carries nothing at build time
      anyway; the target below publishes the CLI with the profile's own SelfContained value.

      Conditional for the same reason the target is.
    -->
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\NekoTrace.Cli\NekoTrace.Cli.csproj')">
        <ProjectReference Include="..\NekoTrace.Cli\NekoTrace.Cli.csproj"
                          ReferenceOutputAssembly="false"
                          SkipGetTargetFrameworkProperties="true"
                          Private="false" />
    </ItemGroup>

    <!--
      Publishes NekoTrace.Cli into this project's publish output so the two ship together, matching the
      runtime and self-containedness of whichever profile is running.

      Conditional because the Dockerfile copies only NekoTrace.Web into its build stage; the image carries
      no CLI by design.
    -->
    <Target Name="PublishNekoTraceCli"
            AfterTargets="Publish"
            Condition="Exists('$(MSBuildProjectDirectory)\..\NekoTrace.Cli\NekoTrace.Cli.csproj')">
        <PropertyGroup>
            <!-- Absolute, or it resolves against the CLI project's directory. -->
            <NekoTraceCliPublishDir>$([System.IO.Path]::GetFullPath('$(PublishDir)', '$(MSBuildProjectDirectory)'))</NekoTraceCliPublishDir>
        </PropertyGroup>
        <MSBuild Projects="..\NekoTrace.Cli\NekoTrace.Cli.csproj"
                 Targets="Publish"
                 RemoveProperties="PublishProfile"
                 Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=$(PublishSingleFile);PublishReadyToRun=$(PublishReadyToRun);PublishDir=$(NekoTraceCliPublishDir)" />
        <Message Importance="high" Text="NekoTrace.Cli published to $(NekoTraceCliPublishDir)" />
    </Target>

    <ItemGroup>
        <Content Update="appsettings.Development.json">
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </Content>
        <Content Update="tsconfig.json">
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>
