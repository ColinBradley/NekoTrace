@{
    var trace = this.Trace;
    if (trace is null)
    {
        if (!this.IsSmallMode)
        {
            <h1>
                Unknown Trace
            </h1>
        }

        return;
    }
}

@*
    The flame graph, its controls and the span detail panel are all the <neko-trace-view> element in
    scripts/trace-view. What stays here belongs to this app rather than to looking at a trace.
*@
<div class="trace @(this.IsSmallMode ? "small" : "full")">
    @if (!this.IsSmallMode)
    {
        <h1>
            <a href="/">Traces</a> / @(trace.RootSpan?.Name ?? trace.Id)
        </h1>
    }

    <div class="commands inline-controls">
        @if (this.IsSmallMode)
        {
            <a href="traces/@Uri.EscapeDataString(this.TraceId)">
                Full View
            </a>
        }

        <a href="/api/trace-files?traceId=@Uri.EscapeDataString(this.TraceId)"
           download>
            Export
        </a>

        <button @onclick="this.RemoveButton_Click"
                class="danger">
            Delete
        </button>

        @if (this.IsSmallMode)
        {
            <a href="@this.Navigation.GetUriWithQueryParameter("TraceId", (string?)null)"
               class="close">
                Close
            </a>
        }
    </div>

    <neko-trace-view @ref="this.TraceViewElement"
                     data-span-color-selector="@this.EffectiveSpanColorSelector"
                     data-span-name-href="/spans/{name}"></neko-trace-view>
</div>
