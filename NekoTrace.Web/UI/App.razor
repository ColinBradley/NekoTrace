@using System.Globalization

<!DOCTYPE html>
@*
    Follows the negotiated culture rather than being pinned to English, so assistive technology announces
    numbers and dates the way they are actually formatted. Deliberately only `lang`: `dir` is left alone
    because nothing in this UI is laid out for right-to-left, and flipping it would break more than it fixed.
*@
<html lang="@(CultureInfo.CurrentCulture.Name is { Length: > 0 } name ? name : "en")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="@this.Assets["images/favicon.svg"]" />
    <link rel="stylesheet" href="@this.Assets["app.css"]" />
    <link rel="stylesheet" href="@this.Assets["NekoTrace.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script type="module" src="/js/copyButton.js"></script>
</body>

</html>
